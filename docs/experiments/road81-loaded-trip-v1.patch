+	// Course authoring assistance only. Resolve and validate both props before
+	// the one-time Y adjustment; all native cargo discovery/range gates remain.
+	protected bool PreparePairStorage()
+	{
+		if (!m_bPairGroundAlignStorage || m_bPairStorageAligned) return true;
+		if (m_bPairBound || m_iPairPhase != 0 || !m_PairCargo.IsEmpty())
+		{ PairFailure("storage_alignment_after_binding"); return false; }
+		World world = GetGame().GetWorld();
+		array<string> names = {"CF_CargoActionSource", "CF_LoadedTripDestination"};
+		array<IEntity> props = {};
+		array<vector> origins = {};
+		array<vector> aligned = {};
+		foreach (string name : names)
+		{
+			IEntity prop = world.FindEntityByName(name);
+			if (!prop) return false;
+			if (Vehicle.Cast(prop) || !prop.FindComponent(SCR_ResourceComponent))
+			{ PairFailure("storage_alignment_not_resource_prop"); return false; }
+			vector before = prop.GetOrigin();
+			vector after = before;
+			after[1] = world.GetSurfaceY(before[0], before[2]);
+			if (!(after[1] >= -1000 && after[1] <= 10000))
+			{ PairFailure("storage_alignment_invalid_surface"); return false; }
+			if (!(Math.AbsFloat(after[1] - before[1]) <= 5))
+			{ PairFailure("storage_alignment_over_5m"); return false; }
+			props.Insert(prop); origins.Insert(before); aligned.Insert(after);
+		}
+		m_bPairStorageAligned = true;
+		for (int index = 0; index < props.Count(); index++)
+		{
+			props[index].SetOrigin(aligned[index]);
+			Print("[ConvoyFollower] LOADED_PAIR_STORAGE_ALIGNMENT: run_id=" + m_sPacedRun +
+				" name=" + names[index] + " entity_id=" + EntityKey(props[index]) +
+				" before=" + origins[index] + " terrain_aligned=" + props[index].GetOrigin() +
+				" test_only=true once_before_binding=true xz_changed=false truck_pose_writes=false count_writes=false native_eligibility_unproved=true");
+		}
+		Vehicle first = Vehicle.Cast(world.FindEntityByName("CF_SmokeFollower1"));
+		Vehicle second = Vehicle.Cast(world.FindEntityByName("CF_SmokeFollower2"));
+		if (!first || !second) { PairFailure("storage_alignment_original_trucks_missing"); return false; }
+		Print("[ConvoyFollower] LOADED_PAIR_STORAGE_GEOMETRY: run_id=" + m_sPacedRun +
+			" source_to_truck1_m=" + vector.Distance(props[0].GetOrigin(), first.GetOrigin()) +
+			" source_to_truck2_m=" + vector.Distance(props[0].GetOrigin(), second.GetOrigin()) +
+			" source_destination_xz_m=" + vector.DistanceXZ(props[0].GetOrigin(), props[1].GetOrigin()) +
+			" geometry_only=true native_eligibility_unproved=true");
+		return true;
+	}
+
