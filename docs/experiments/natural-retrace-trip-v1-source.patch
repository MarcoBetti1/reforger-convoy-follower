@@ -93,6 +93,121 @@ class CF_TrailGuideWaypointState : SCR_AIWaypointState
 // budget. QueryPhysical also admits a proven, bounded connected local chain.
 class CF_TrailGuideRoute : CF_DrivenRoute
 {
+	// Delay only an unconsumed, tiny backwards excursion at the recorded tip.
+	// Committed points/stations never change. Real longer reverse/turns flush.
+	protected ref array<vector> m_RetracePoints = {};
+	protected bool m_RetracePending;
+	protected int m_RetraceKey;
+	protected vector m_RetraceAnchor;
+	protected vector m_RetraceTangent;
+	protected float m_RetraceStation;
+	protected float m_RetraceStartMs;
+	protected float m_RetraceLastMs;
+	protected static const float CF_RETRACE_METERS = 2.0;
+	protected static const float CF_RETRACE_MS = 5000.0;
+	protected static const int CF_RETRACE_POINTS = 16;
+
+	bool HasPendingRetrace() { return m_RetracePending; }
+
+	protected bool RetraceSuffixAvailable(float guideFrontier, vector tangent)
+	{
+		int last = m_Points.Count() - 1;
+		float boundary = m_Stations[last] - CF_RETRACE_METERS;
+		float consumed = Math.Max(m_HighWaterProgress, Math.Max(m_Progress, guideFrontier));
+		if (!m_Joined || consumed >= boundary) return false;
+		// The whole tiny suffix must already be a straight, retained driven line.
+		for (int index = last - 1; index >= 0 && last - index <= 6; index--)
+		{
+			vector leg = m_Points[index + 1] - m_Points[index];
+			leg[1] = 0;
+			if (!(leg.LengthSq() > 0)) return false;
+			leg.Normalize();
+			if (vector.Dot(leg, tangent) < 0.9) return false;
+			vector offset = m_Points[index] - m_Points[last];
+			offset[1] = 0;
+			vector lateral = offset - tangent * vector.Dot(offset, tangent);
+			if (lateral.Length() > MIN_SAMPLE) return false;
+			if (m_Stations[index] <= boundary) return true;
+		}
+		return false;
+	}
+
+	protected bool FlushRetrace(int targetKey, vector pose)
+	{
+		foreach (vector recorded : m_RetracePoints)
+			if (!Record(targetKey, recorded)) return false;
+		m_RetracePoints.Clear();
+		m_RetracePending = false;
+		return Record(targetKey, pose);
+	}
+
+	// Only this caller opts in; ordinary Record and every physical Query stay unchanged.
+	bool RecordPredecessorPose(int targetKey, vector pose, vector forward, float worldMs,
+		float guideFrontier, out string eventReason)
+	{
+		eventReason = "";
+		if (!m_Initialized || targetKey != m_TargetKey || m_HistoryLost || m_Discontinuous) return false;
+		if (!FinitePose(pose) || !FinitePose(forward) || !FiniteValue(worldMs) || !FiniteValue(guideFrontier)) return false;
+		forward[1] = 0;
+		if (!(forward.LengthSq() > 0) || worldMs < 0) return false;
+		forward.Normalize();
+		int last = m_Points.Count() - 1;
+		if (m_RetracePending)
+		{
+			if (targetKey != m_RetraceKey || m_Points[last] != m_RetraceAnchor || m_Stations[last] != m_RetraceStation) return false;
+			if (worldMs < m_RetraceLastMs) return false;
+			m_RetraceLastMs = worldMs;
+			vector offset = pose - m_RetraceAnchor;
+			offset[1] = 0;
+			float along = vector.Dot(offset, m_RetraceTangent);
+			vector lateral = offset - m_RetraceTangent * along;
+			string flush;
+			if (!RetraceSuffixAvailable(guideFrontier, m_RetraceTangent)) flush = "frontier_or_suffix";
+			else if (worldMs - m_RetraceStartMs > CF_RETRACE_MS) flush = "timeout";
+			else if (vector.Dot(forward, m_RetraceTangent) < 0.9 || lateral.Length() > MIN_SAMPLE) flush = "turn_or_lateral";
+			else if (along < 0 && offset.Length() > CF_RETRACE_METERS) flush = "distance";
+			if (!flush.IsEmpty())
+			{
+				eventReason = "buffer_flushed_" + flush;
+				return FlushRetrace(targetKey, pose);
+			}
+			if (along >= 0)
+			{
+				// Actual forward return, with unchanged facing/corridor. No spur
+				// point was published or consumed; no cursor/epoch is advanced.
+				m_RetracePoints.Clear();
+				m_RetracePending = false;
+				eventReason = "buffer_discarded";
+				return Record(targetKey, pose);
+			}
+			if (vector.DistanceXZ(m_RetracePoints[m_RetracePoints.Count() - 1], pose) < MIN_SAMPLE) return true;
+			if (m_RetracePoints.Count() >= CF_RETRACE_POINTS)
+			{
+				eventReason = "buffer_flushed_count";
+				return FlushRetrace(targetKey, pose);
+			}
+			m_RetracePoints.Insert(pose);
+			return true;
+		}
+		if (last < 1 || vector.DistanceXZ(m_Points[last], pose) < MIN_SAMPLE) return Record(targetKey, pose);
+		vector tangent = m_Points[last] - m_Points[last - 1];
+		tangent[1] = 0;
+		if (!(tangent.LengthSq() > 0)) return Record(targetKey, pose);
+		tangent.Normalize();
+		vector delta = pose - m_Points[last];
+		delta[1] = 0;
+		float backward = vector.Dot(delta, tangent);
+		vector lateralDelta = delta - tangent * backward;
+		if (backward >= 0 || delta.Length() > CF_RETRACE_METERS || lateralDelta.Length() > MIN_SAMPLE) return Record(targetKey, pose);
+		if (vector.Dot(forward, tangent) < 0.9 || !RetraceSuffixAvailable(guideFrontier, tangent)) return Record(targetKey, pose);
+		m_RetraceAnchor = m_Points[last]; m_RetraceStation = m_Stations[last];
+		m_RetraceTangent = tangent; m_RetraceKey = targetKey;
+		m_RetraceStartMs = worldMs; m_RetraceLastMs = worldMs;
+		m_RetracePoints.Insert(pose); m_RetracePending = true;
+		eventReason = "buffer_started";
+		return true;
+	}
+
 	// Value-only, one-query context. Ordinary Query never arms the hook.
 	protected bool m_PhysicalQueryActive;
 	protected bool m_PhysicalAllowReverse;
@@ -296,6 +411,8 @@ class CF_TrailGuideRoute : CF_DrivenRoute
 
