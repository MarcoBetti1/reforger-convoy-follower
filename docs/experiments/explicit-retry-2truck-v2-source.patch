diff --git a/addons/ConvoyFollower/Scripts/Game/Tests/CF_ExplicitRetryProbeComponent.c b/addons/ConvoyFollower/Scripts/Game/Tests/CF_ExplicitRetryProbeComponent.c
new file mode 100644
index 0000000..28a856c
--- /dev/null
+++ b/addons/ConvoyFollower/Scripts/Game/Tests/CF_ExplicitRetryProbeComponent.c
@@ -0,0 +1,293 @@
+// Isolated command-recovery fixture. The only induced failure is the same
+// authored lease.Block boundary used by CF_OriginalFollowRetire. It is NOT
+// evidence of a native path-planner UNREACHABLE result or arrival recovery.
+class CF_ExplicitRetryReadback
+{
+	CF_DrivenRoute Route;
+	CF_OriginalFollowLease Lease;
+	CF_EntityFollowWaypoint Waypoint;
+	IEntity Predecessor;
+	int Epoch;
+	int Generation;
+	bool Joined;
+	bool OriginalBlocked;
+	bool BlockApplied;
+	bool ActiveFallback;
+	bool TrailBlocked;
+	bool ArrivalRecovery;
+	bool ResumePending;
+	float ResumeBeginMs;
+	CF_InitialDepartureWait ResumeWait;
+	string Failure;
+}
+
+// Read-only test access; no order, failure, route or controller flag is written.
+modded class CF_ConvoyFollowDriverControllerComponent
+{
+	void CF_TestReadExplicitRetry(CF_ExplicitRetryReadback sample)
+	{
+		if (!sample) return;
+		sample.Route = m_TrailRoute;
+		sample.Lease = m_OriginalFollowLease;
+		sample.Waypoint = CF_EntityFollowWaypoint.Cast(m_Waypoint);
+		sample.Predecessor = m_TrailPredecessor;
+		sample.Epoch = m_iTrailEpoch;
+		sample.Generation = m_iOriginalFollowGeneration;
+		sample.Joined = m_bTrailJoined;
+		sample.OriginalBlocked = m_bOriginalFollowBlocked;
+		sample.BlockApplied = m_bOriginalFollowBlockApplied;
+		sample.ActiveFallback = CF_HasActiveEntityFallbackFailure();
+		sample.TrailBlocked = m_bTrailBlocked;
+		sample.ArrivalRecovery = m_bArrivalRecoveryActive;
+		sample.ResumePending = m_bTrailResumePending;
+		sample.ResumeBeginMs = m_fTrailResumeBeginMs;
+		sample.ResumeWait = m_TrailResumeWait;
+		sample.Failure = m_sOriginalFollowFailure;
+	}
+}
+
+class CF_ExplicitRetryProbeComponentClass : CF_LoadedPairTripProbeComponentClass {}
+
+class CF_ExplicitRetryProbeComponent : CF_LoadedPairTripProbeComponent
+{
+	protected const string RETRY_FAILURE = "SYNTHETIC_AUTHORED_ORDER_FAILURE_explicit_retry_fixture";
+	protected ref CF_OriginalFollowLease m_RetryFailedLease;
+	protected ref CF_OriginalFollowActivity m_RetryFailedActivity;
+	protected CF_DrivenRoute m_RetryRoute;
+	protected int m_iRetryEpoch;
+	protected int m_iRetryGeneration;
+	protected int m_iRetryHandler;
+	protected int m_iRetryInjectionCount;
+	protected int m_iRetryStage; // 0 travel, 1 failed retirement, 2 lead stop, 3 Hold settling, 4 held, 5 fresh Resume
+	protected bool m_bRetryComplete;
+	protected bool m_bRetryResult;
+	protected bool m_bRetryExpectedFailureObserved;
+	protected bool m_bRetryDuplicateRejected;
+
+	override protected string PairCourseWorld()
+	{
+		return "Worlds/Tests/ConvoyFollower_Arland_ExplicitRetry_2Trucks.ent";
+	}
+	override protected bool PairUsesBaselineArrival() { return false; }
+
+	override void OnPostInit(IEntity owner)
+	{
+		super.OnPostInit(owner);
+		if (!Replication.IsServer()) return;
+		if (!m_bPairCommandsOnly || !m_bPairCooperativeLead || m_bPairGroundAlignStorage)
+			PairFailure("explicit_retry_fixture_contract");
+		Print("[ConvoyFollower] EXPLICIT_RETRY_INIT: run_id=" + m_sPacedRun +
+			" world=" + PairCourseWorld() + " expected=2 injection=SYNTHETIC_AUTHORED_ORDER_FAILURE injection_max=1" +
+			" precondition_each_m=20 precondition_each_powered=3 genuine_tail_join=true hold_s=30 hold_drift_m=2 hold_speed_kmh=2" +
+			" restart_each_m=20 restart_each_powered=3 max_link_m=60 total_timeout_s=360 recovery_timeout_s=240 phase_timeout_s=90" +
+			" cargo_tested=false arrival180_tested=false native_planner_failure_claim=false arrival_recovery_claim=false" +
+			" ordinary_input=false setup=existing_native_pilot_and_owner follower_control_writes=false");
+	}
+
+	protected CF_ExplicitRetryReadback RetryRead()
+	{
+		CF_ExplicitRetryReadback read = new CF_ExplicitRetryReadback();
+		if (PairDriver(2)) PairDriver(2).CF_TestReadExplicitRetry(read);
+		return read;
+	}
+
+	protected bool RetryHistory(CF_ExplicitRetryReadback read)
+	{
+		if (!read || !m_RetryFailedLease || !m_RetryFailedActivity || m_iRetryInjectionCount != 1) return false;
+		if (!m_RetryFailedLease.Failed || !m_RetryFailedLease.Revoked || m_RetryFailedLease.Activity != m_RetryFailedActivity) return false;
+		if (m_RetryFailedLease.Controller != PairDriver(2) || m_RetryFailedLease.Session != m_PacedSession) return false;
+		if (m_RetryFailedLease.Driver != m_PacedTrucks[2].Pilot || m_RetryFailedLease.Truck != m_PacedTrucks[2].Truck) return false;
+		if (m_RetryFailedLease.Group != m_PacedTrucks[2].Group || m_RetryFailedLease.Predecessor != m_PacedTrucks[1].Truck) return false;
+		if (m_RetryFailedLease.Generation != m_iRetryGeneration || m_RetryFailedLease.OriginalWorld != GetGame().GetWorld()) return false;
+		if (!read.Route || read.Route != m_RetryRoute || read.Route.GetPointCount() < 2 || !read.Joined) return false;
+		if (read.Epoch != m_iRetryEpoch || read.Predecessor != m_PacedTrucks[1].Truck) return false;
+		if (read.TrailBlocked || read.ArrivalRecovery) return false;
+		if (read.Lease && read.Lease != m_RetryFailedLease && (read.Lease.Failed || read.Lease.Revoked)) return false;
+		return true;
+	}
+
+	override protected bool PairControllerFailed(int unit, CF_ConvoyFollowDriverControllerComponent driver)
+	{
+		if (unit != 2 || m_iRetryInjectionCount == 0) return super.PairControllerFailed(unit, driver);
+		CF_ExplicitRetryReadback read = RetryRead();
+		if (!RetryHistory(read)) return true;
+		if (m_iRetryStage < 5)
+			return !read.OriginalBlocked || !read.ActiveFallback || read.Failure != RETRY_FAILURE;
+		return read.OriginalBlocked || read.ActiveFallback;
+	}
+
+	override protected bool MixedControllerFailed(int unit, CF_EntityFollowDriverControllerComponent driver)
+	{
+		if (unit != 2 || m_iRetryInjectionCount == 0) return super.MixedControllerFailed(unit, driver);
+		if (m_iRetryStage != 5 || PairControllerFailed(unit, PairDriver(unit))) return true;
+		return driver.CF_HasActiveEntityFallbackFailure();
+	}
+
+	protected bool TryInjectRetryFailure()
+	{
+		if (m_iRetryInjectionCount != 0 || !m_bPacedStarted || !CommandIdentities()) return false;
+		for (int unit = 1; unit <= 2; unit++)
+		{
+			CF_OriginalTailGuideEvidence evidence = m_MixedUnits[unit - 1];
+			if (!evidence.PreviousEligible || evidence.Progress < 20 || evidence.PoweredSamples < 3) return false;
+		}
+		CF_ExplicitRetryReadback read = RetryRead();
+		if (!read.Joined || !read.Route || read.Epoch <= 0 || read.Predecessor != m_PacedTrucks[1].Truck) return false;
+		if (read.OriginalBlocked || read.ActiveFallback || read.TrailBlocked || read.ArrivalRecovery) return false;
+		CF_OriginalFollowLease lease = read.Lease;
+		string reason;
+		if (!lease || !lease.Activity || !lease.Executing(m_PacedTrucks[2].Group, reason)) return false;
+		if (lease.Controller != PairDriver(2) || lease.Session != m_PacedSession || lease.Waypoint != read.Waypoint) return false;
+		if (lease.NativeTarget != PairDriver(2).CF_GetTrailGuideEntity() || lease.Predecessor != m_PacedTrucks[1].Truck) return false;
+		if (!PairDriver(1).CF_IsMovementActive() || PairDriver(1).CF_HasPanelHoldRequest()) return false;
+		SCR_AIGroupUtilityComponent headUtility = GroupUtility(m_PacedTrucks[1]);
+		CF_OriginalFollowActivity headActivity;
+		if (headUtility) headActivity = CF_OriginalFollowActivity.Cast(headUtility.GetCurrentAction());
+		if (!headActivity || !headActivity.Lease || headActivity.Lease.Distance != CF_ConvoySettings.Get().m_fMovingGap) return false;
+		if (!headActivity.Lease.Executing(m_PacedTrucks[1].Group, reason)) return false;
+		Physics physics = m_PacedTrucks[1].Truck.GetPhysics();
+		vector forward = m_PacedTrucks[1].Truck.GetWorldTransformAxis(2);
+		if (!physics || !(3.6 * vector.Dot(physics.GetVelocity(), forward) > 1.5)) return false;
+		AIGroupMovementComponent movement = AIGroupMovementComponent.Cast(m_PacedTrucks[2].Group.GetMovementComponent());
+		if (!movement) return false;
+		int handler = movement.GetAgentMoveHandlerId(lease.Agent);
+		if (handler <= AIGroupMovementComponent.DEFAULT_HANDLER_ID) return false;
+		m_RetryFailedLease = lease; m_RetryFailedActivity = lease.Activity;
+		m_RetryRoute = read.Route; m_iRetryEpoch = read.Epoch; m_iRetryGeneration = lease.Generation; m_iRetryHandler = handler;
+		m_iRetryInjectionCount = 1; m_iRetryStage = 1;
+		for (int index = 0; index < 2; index++) m_BaselineSequences[index] = m_MixedUnits[index].ActivitySequence;
+		m_fPairCommandMs = GetGame().GetWorld().GetWorldTime();
+		SetPairPhase(20);
+		string injected = "[ConvoyFollower] EXPLICIT_RETRY_INJECT: kind=SYNTHETIC_AUTHORED_ORDER_FAILURE count=1 unit=2";
+		injected += " generation=" + lease.Generation + " sequence=" + lease.Activity.CF_GetSequence() + " activity=" + lease.Activity.ToString();
+		injected += " waypoint=" + EntityKey(lease.Waypoint) + " handler=" + handler + " predecessor=" + EntityKey(lease.Predecessor);
+		injected += " epoch=" + read.Epoch + " genuinely_joined=true original_execution=true native_planner_failure_claim=false";
+		injected += " native_arrival_recovery_claim=false failed_attempt_remains_recorded=true";
+		Print(injected);
+		lease.Block(RETRY_FAILURE); // Exact authored terminal-failure sink; never raw flag assignment.
+		return true;
+	}
+
+	override protected void Poll()
+	{
+		if (!PacedWorldAlive() || m_bPacedTerminal) return;
+		float now = GetGame().GetWorld().GetWorldTime();
+		if (PacedSeconds() > 360) { PairFailure("explicit_retry_total_timeout_360s"); return; }
+		if (m_iRetryInjectionCount == 0)
+		{
+			super.Poll();
+			if (!m_bPacedTerminal) TryInjectRetryFailure();
+			return;
+		}
