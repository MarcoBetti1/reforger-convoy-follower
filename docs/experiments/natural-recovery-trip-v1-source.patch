diff --git a/addons/ConvoyFollower/Scripts/Game/Tests/CF_NaturalRecoveryTripProbeComponent.c b/addons/ConvoyFollower/Scripts/Game/Tests/CF_NaturalRecoveryTripProbeComponent.c
