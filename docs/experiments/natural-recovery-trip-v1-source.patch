--- /dev/null
+++ b/addons/ConvoyFollower/Scripts/Game/Tests/CF_NaturalRecoveryTripProbeComponent.c
@@ -0,0 +1,315 @@
+// Private full-supply fixture: one scripted owner response to a REAL failed
+// original native move. No failure injection, controller writes or new pilot.
+class CF_NaturalRecoveryReadback
+{
+	CF_DrivenRoute Route;
+	CF_OriginalFollowLease Lease;
+	CF_EntityFollowWaypoint Waypoint;
+	IEntity Predecessor;
+	int Epoch;
+	int Generation;
+	bool Joined;
+	bool OriginalBlocked;
+	bool BlockApplied;
+	bool ActiveFallback;
+	bool TrailBlocked;
+	bool ArrivalRecovery;
+	string Failure;
+}
+
+// Observation only. The retained reference is never made executable again.
+modded class CF_ConvoyFollowDriverControllerComponent
+{
+	void CF_TestReadNaturalRecovery(CF_NaturalRecoveryReadback read)
+	{
+		if (!read) return;
+		read.Route = m_TrailRoute; read.Lease = m_OriginalFollowLease;
+		read.Waypoint = CF_EntityFollowWaypoint.Cast(m_Waypoint);
+		read.Predecessor = m_TrailPredecessor; read.Epoch = m_iTrailEpoch;
+		read.Generation = m_iOriginalFollowGeneration; read.Joined = m_bTrailJoined;
+		read.OriginalBlocked = m_bOriginalFollowBlocked; read.BlockApplied = m_bOriginalFollowBlockApplied;
+		read.ActiveFallback = CF_HasActiveEntityFallbackFailure(); read.TrailBlocked = m_bTrailBlocked;
+		read.ArrivalRecovery = m_bArrivalRecoveryActive; read.Failure = m_sOriginalFollowFailure;
+	}
+}
+
+class CF_NaturalRecoveryTripProbeComponentClass : CF_LoadedPairTripProbeComponentClass {}
+
+class CF_NaturalRecoveryTripProbeComponent : CF_LoadedPairTripProbeComponent
+{
+	protected ref CF_OriginalFollowLease m_NaturalLease;
+	protected ref CF_OriginalFollowActivity m_NaturalActivity;
+	protected CF_DrivenRoute m_NaturalRoute;
+	protected int m_iNaturalEpoch;
+	protected int m_iNaturalGeneration;
+	protected int m_iNaturalHandler;
+	protected float m_fNaturalWitnessMs = -1;
+	protected int m_iNaturalCount;
+	protected int m_iNaturalStage; // 0 normal; 1 retirement; 2 stop; 3 settle Hold; 4 Hold; 5 continuing trip
+	protected string m_sNaturalReason;
+	protected vector m_vNaturalGoal;
+	protected vector m_vNaturalResumeTail;
+	protected float m_fNaturalHeldSeconds;
+	protected int m_iNaturalHeldSamples;
+	protected bool m_bNaturalHoldAccepted;
+	protected bool m_bNaturalResumeAccepted;
+	protected bool m_bNaturalRetired;
+	protected bool m_bNaturalResult;
+	protected int m_iNaturalMovementLogs;
+
+	override protected string PairCourseWorld()
+	{
+		return "Worlds/Tests/ConvoyFollower_Arland_NaturalRecoverySupplyTrip_2Trucks.ent";
+	}
+
+	override void OnPostInit(IEntity owner)
+	{
+		super.OnPostInit(owner);
+		if (!Replication.IsServer()) return;
+		if (m_bPairCommandsOnly || !m_bPairCooperativeLead || !m_bPairGroundAlignStorage)
+			PairFailure("natural_recovery_fixture_contract");
+		Print("[ConvoyFollower] NATURAL_RECOVERY_INIT: maximum_owner_responses=1 failure_injection=false" +
+			" failure_kind=admitted_native_move_3 original_destination_preserved=true recovery_hold_s=30 recovery_drift_m=2" +
+			" total_timeout_s=720 phase_timeout_s=90 recovery_timeout_s=240 cargo_total=1800 delivery=200" +
+			" arrival_s=180 final_resume_each_m=20 final_resume_each_powered=3 max_link_m=60 ordinary_input=false");
+	}
+
+	protected CF_NaturalRecoveryReadback NaturalRead()
+	{
+		CF_NaturalRecoveryReadback read = new CF_NaturalRecoveryReadback();
+		if (PairDriver(2)) PairDriver(2).CF_TestReadNaturalRecovery(read);
+		return read;
+	}
+
+	// Pin an actual selected/executing, joined native order before retirement.
+	protected void PinNaturalWitness(float now)
+	{
+		if (m_iNaturalCount != 0 || m_iPairPhase != 1 || !m_bPacedStarted || m_bPacedObserving) return;
+		if (!CommandIdentities() || !m_sPendingRouteResult.IsEmpty()) return;
+		CF_NaturalRecoveryReadback read = NaturalRead();
+		if (!read.Joined || !read.Route || read.Epoch <= 0 || read.TrailBlocked || read.ArrivalRecovery) return;
+		CF_OriginalFollowLease lease = read.Lease;
+		string reason;
+		if (!lease || !lease.Activity || !lease.Executing(m_PacedTrucks[2].Group, reason)) return;
+		if (lease.NativeTarget != PairDriver(2).CF_GetTrailGuideEntity() || lease.Predecessor != m_PacedTrucks[1].Truck) return;
+		if (read.OriginalBlocked || read.ActiveFallback || PairDriver(1).CF_HasPanelHoldRequest()) return;
+		if (!PairDriver(1).CF_IsMovementActive()) return;
+		Physics physics = m_PacedTrucks[1].Truck.GetPhysics();
+		if (!physics || !(3.6 * vector.Dot(physics.GetVelocity(), m_PacedTrucks[1].Truck.GetWorldTransformAxis(2)) > 1.5)) return;
+		AIGroupMovementComponent movement = AIGroupMovementComponent.Cast(m_PacedTrucks[2].Group.GetMovementComponent());
+		if (!movement) return;
+		int handler = movement.GetAgentMoveHandlerId(lease.Agent);
+		if (handler <= AIGroupMovementComponent.DEFAULT_HANDLER_ID) return;
+		m_NaturalLease = lease; m_NaturalActivity = lease.Activity; m_NaturalRoute = read.Route;
+		m_iNaturalEpoch = read.Epoch; m_iNaturalGeneration = lease.Generation; m_iNaturalHandler = handler;
+		m_fNaturalWitnessMs = now;
+	}
+
+	protected bool NaturalHistory(CF_NaturalRecoveryReadback read)
+	{
+		if (m_iNaturalCount != 1 || !read || !m_NaturalLease || !m_NaturalActivity) return false;
+		if (!m_NaturalLease.Failed || !m_NaturalLease.Revoked || m_NaturalLease.ArrivalRecoveryOwned) return false;
+		if (m_NaturalLease.Activity != m_NaturalActivity || m_NaturalLease.Controller != PairDriver(2)) return false;
+		if (m_NaturalLease.Session != m_PacedSession || m_NaturalLease.Generation != m_iNaturalGeneration) return false;
+		if (m_NaturalLease.Driver != m_PacedTrucks[2].Pilot || m_NaturalLease.Truck != m_PacedTrucks[2].Truck) return false;
+		if (m_NaturalLease.Group != m_PacedTrucks[2].Group || m_NaturalLease.Predecessor != m_PacedTrucks[1].Truck) return false;
+		if (m_NaturalLease.OriginalWorld != GetGame().GetWorld() || read.TrailBlocked || read.ArrivalRecovery) return false;
+		if (!read.Route || read.Route != m_NaturalRoute || read.Route.GetPointCount() < 2 || !read.Joined) return false;
+		if (read.Epoch != m_iNaturalEpoch || read.Predecessor != m_PacedTrucks[1].Truck) return false;
+		// Ordinary healthy retirement may revoke a later approach; a second
+		// failed lease is never recoverable by this one-response fixture.
+		if (read.Lease && read.Lease != m_NaturalLease && read.Lease.Failed) return false;
+		return true;
+	}
+
+	override protected bool PairControllerFailed(int unit, CF_ConvoyFollowDriverControllerComponent driver)
+	{
+		if (unit != 2 || m_iNaturalCount == 0) return super.PairControllerFailed(unit, driver);
+		CF_NaturalRecoveryReadback read = NaturalRead();
+		if (!NaturalHistory(read)) return true;
+		if (m_iNaturalStage < 5)
+			return !read.OriginalBlocked || !read.ActiveFallback || read.Failure != m_sNaturalReason;
+		return read.OriginalBlocked || read.ActiveFallback;
+	}
+
+	override protected bool MixedControllerFailed(int unit, CF_EntityFollowDriverControllerComponent driver)
+	{
+		if (unit != 2 || m_iNaturalCount == 0) return super.MixedControllerFailed(unit, driver);
+		return m_iNaturalStage != 5 || PairControllerFailed(unit, PairDriver(unit));
+	}
+
+	protected bool AdmitNaturalFailure(float now)
+	{
+		if (m_iNaturalCount != 0 || m_iPairPhase != 1 || m_bPacedObserving || !m_bPacedStarted) return false;
+		if (!m_NaturalLease || !m_NaturalLease.Failed || !m_NaturalLease.Revoked || m_NaturalLease.ArrivalRecoveryOwned) return false;
+		if (m_fNaturalWitnessMs < 0 || now - m_fNaturalWitnessMs > 1500 || now < m_fNaturalWitnessMs) return false;
+		CF_NaturalRecoveryReadback read = NaturalRead();
+		string expected = "guard_or_request_failure_admitted_move_3_handler_" + m_iNaturalHandler;
+		if (!read.OriginalBlocked || !read.ActiveFallback || read.Failure != expected) return false;
+		if (read.Generation != m_iNaturalGeneration || !m_sPendingRouteResult.IsEmpty()) return false;
+		m_iNaturalCount = 1; m_iNaturalStage = 1; m_sNaturalReason = expected;
+		if (!NaturalHistory(read) || !CommandIdentities()) { PairFailure("natural_failure_binding_changed"); return true; }
+		// Preserve the raw overall FAIL. Only this named, exact failed attempt
+		// may continue toward a separately reported recovered workflow.
+		m_bPacedFailed = true;
+		if (m_sFirstFailure.IsEmpty()) m_sFirstFailure = "natural_original_order:" + expected;
+		Print("[ConvoyFollower] PACED_FAILURE: run_id=" + m_sPacedRun + " scope=natural_original_order reason=" + expected + " recovery_response_pending=true");
+		m_vNaturalGoal = m_vRoadGoal; m_fPairCommandMs = now; SetPairPhase(20);
+		// Stop interval continuity, preserving separately earned best-attempt proof.
+		for (int index = 0; index < 2; index++) m_MixedUnits[index].PreviousEligible = false;
+		string line = "[ConvoyFollower] NATURAL_RECOVERY_FAILURE: count=1 unit=2 reason=" + expected;
+		line += " generation=" + m_iNaturalGeneration + " sequence=" + m_NaturalActivity.CF_GetSequence();
+		line += " activity=" + m_NaturalActivity.ToString() + " epoch=" + m_iNaturalEpoch + " handler=" + m_iNaturalHandler;
+		line += " witness_age_ms=" + (now - m_fNaturalWitnessMs) + " original_goal=" + m_vNaturalGoal;
+		line += " failed_attempt_retained=true failure_injection=false clean_first_attempt=false";
+		Print(line);
+		return true;
+	}
+
+	override void EOnPostFrame(IEntity owner, float timeSlice)
+	{
+		if (PacedWorldAlive() && !m_bPacedTerminal)
+		{
+			float now = GetGame().GetWorld().GetWorldTime();
+			if (m_iNaturalCount == 0) { AdmitNaturalFailure(now); if (!m_bPacedTerminal) PinNaturalWitness(now); }
+			else if (!NaturalHistory(NaturalRead())) PairFailure("natural_recovery_retained_history_or_second_failure");
+		}
+		// Inherited exact ledger, physical Hold, assignment and spacing checks run.
+		super.EOnPostFrame(owner, timeSlice);
+	}
+
+	protected bool ContinueOriginalGoal()
+	{
+		if (!CommandIdentities() || !CanControlLead() || !OwnerRetained() || !EntryReady(m_PacedTrucks[0])) return false;
+		if (!LeadWaitSelected() || m_PilotWaypoint || vector.Distance(m_vNaturalGoal, m_vRoadGoal) > 0.001) return false;
+		// Never extend the route to manufacture departure distance.
+		// The unchanged baseline marks its goal reached at 14 m.
+		if (m_bRoadGoalReached || !(vector.Distance(m_Lead.GetOrigin(), m_vNaturalGoal) > 14)) return false;
+		Resource prefab = Resource.Load("{750A8D1695BD6998}Prefabs/AI/Waypoints/AIWaypoint_Move.et");
+		if (!prefab.IsValid()) return false;
+		EntitySpawnParams params = EntitySpawnParams();
+		params.TransformMode = ETransformMode.WORLD; params.Transform[3] = m_vNaturalGoal;
+		SCR_AIWaypoint waypoint = SCR_AIWaypoint.Cast(GetGame().SpawnEntityPrefabLocal(prefab, null, params));
+		if (!waypoint) return false;
+		if (!m_PacedCruise.Request(m_Pilot, m_Lead, 0, "natural_recovery_original_goal"))
+		{ SCR_EntityHelper.DeleteEntityAndChildren(waypoint); return false; }
+		m_vTransferOrigin = m_Lead.GetOrigin(); m_bCommandParking = true;
+		m_PacedWait.Complete(); m_PacedWait = null;
+		m_bPacedHoldingLead = false; m_bPacedOwnBrake = false;
+		waypoint.SetPriorityLevel(SCR_AIActionBase.PRIORITY_LEVEL_GAMEMASTER);
+		waypoint.SetCompletionRadius(5);
+		m_PilotWaypoint = waypoint; m_PilotGroup.AddWaypoint(waypoint);
+		ReleaseCommandParking("natural_recovery_same_delivery_goal");
+		Print("[ConvoyFollower] NATURAL_RECOVERY_CONTINUE: lead=" + m_Lead.GetOrigin() + " goal=" + m_vNaturalGoal +
+			" original_destination=true route_extension=false original_cargo=true lead_cap_kmh=0 fresh_advice_required=true");
+		return true;
+	}
+
+	protected void ResetRecoveryHoldScratch()
+	{
+		m_bPairHoldMeasure = false; m_bPairHoldAccepted = false; m_bPairResumeAccepted = false;
+		m_fHoldBeginMs = 0; m_fHoldCompletedSeconds = 0; m_fHoldLastSampleMs = 0;
+		m_iHoldSamples = 0; m_iHoldStable = 0; m_HoldOrigins.Clear();
+		for (int index = 0; index < 2; index++) { m_HoldDrifts[index] = 0; m_HoldSpeeds[index] = 0; }
+	}
+
+	override protected void Poll()
+	{
+		if (!PacedWorldAlive() || m_bPacedTerminal) return;
+		float now = GetGame().GetWorld().GetWorldTime();
+		if (m_iNaturalCount == 0) AdmitNaturalFailure(now);
+		if (m_bPacedTerminal) return;
+		if (m_iNaturalStage == 0 || m_iNaturalStage == 5)
+		{
+			if (m_iNaturalStage == 5 && !CommandIdentities()) { PairFailure("natural_recovery_current_identity_or_failure"); return; }
+			super.Poll();
+			if (!m_bPacedTerminal && m_iNaturalStage == 0) PinNaturalWitness(now);
+			if (!m_bPacedTerminal && m_iNaturalStage == 5 && m_iPairPhase == 1 && m_iNaturalMovementLogs < 90)
+			{
+				m_iNaturalMovementLogs++;
+				CF_OriginalTailGuideEvidence evidence = m_MixedUnits[1];
+				string line = "[ConvoyFollower] NATURAL_RECOVERY_TRAVEL: tail=" + m_PacedTrucks[2].Truck.GetOrigin();
+				line += " displacement_m=" + vector.DistanceXZ(m_vNaturalResumeTail, m_PacedTrucks[2].Truck.GetOrigin());
+				line += " sequence=" + evidence.ActivitySequence + " progress_m=" + evidence.Progress + " powered=" + evidence.PoweredSamples;
+				line += " epoch=" + evidence.ObservedEpoch + " observing_arrival=" + m_bPacedObserving + " old_failure_retained=true";
+				Print(line);
+			}
+			return;
+		}
+		if (PacedSeconds() > 720 || now - m_fPairCommandMs > 240000 || now - m_fPairPhaseMs > 90000)
+		{ PairFailure("natural_recovery_phase_or_total_timeout"); return; }
+		if (m_bPairNonSpacingFailure || !CommandIdentities() || !CheckPairLedger())
+		{ PairFailure("natural_recovery_identity_cargo_or_unexpected_failure"); return; }
+		if (!UpdateCooperativeLead(now)) return;
+		m_iPacedTick++; MeasurePeaks(); MeasurePairHold(); LogPairHold(now);
+		if (m_bPacedTerminal) return;
+		CF_NaturalRecoveryReadback read = NaturalRead();
+		if (m_iNaturalStage == 1)
+		{
+			if (now - m_fPairPhaseMs > 10000) { PairFailure("natural_failed_slot_not_retired_10s"); return; }
+			if (!read.BlockApplied || read.Lease || read.Waypoint || PairDriver(2).CF_GetTrailGuideEntity()) return;
+			m_bNaturalRetired = true; HoldLeadAtRoadGoal(); m_iNaturalStage = 2; SetPairPhase(21);
+		}
+		else if (m_iNaturalStage == 2)
+		{
+			if (!LeadWaitSelected() || CommandSpeed(m_Lead) > 2 || !CommandSeat(m_PacedOwner, false)) return;
+			m_bNaturalHoldAccepted = CF_ConvoySession.CF_PanelHold(m_PacedOwner);
+			Print("[ConvoyFollower] NATURAL_RECOVERY_HOLD: accepted=" + m_bNaturalHoldAccepted + " public_server_command=true");
+			if (!m_bNaturalHoldAccepted) { PairFailure("natural_recovery_hold_rejected"); return; }
+			m_iNaturalStage = 3; SetPairPhase(22);
+		}
+		else if (m_iNaturalStage == 3)
+		{
+			if (PairHeld() && CommandSpeed(m_PacedTrucks[1].Truck) <= 2 && CommandSpeed(m_PacedTrucks[2].Truck) <= 2) m_iHoldStable++;
+			else m_iHoldStable = 0;
+			if (m_iHoldStable < 3) return;
+			m_HoldOrigins.Insert(m_PacedTrucks[1].Truck.GetOrigin()); m_HoldOrigins.Insert(m_PacedTrucks[2].Truck.GetOrigin());
+			m_fHoldBeginMs = now; m_fHoldLastSampleMs = now; m_bPairHoldMeasure = true;
+			m_iNaturalStage = 4; SetPairPhase(23);
+		}
+		else if (m_iNaturalStage == 4)
+		{
+			if (now - m_fHoldBeginMs < 30000 || m_iHoldSamples < 30) return;
+			if (!LeadWaitSelected() || !CanControlLead() || !CommandSeat(m_PacedOwner, false))
+			{ PairFailure("natural_recovery_lead_or_owner_lost"); return; }
+			if (m_bRoadGoalReached || !(vector.Distance(m_Lead.GetOrigin(), m_vNaturalGoal) > 14))
+			{ PairFailure("natural_recovery_original_goal_already_in_arrival_range"); return; }
+			m_fNaturalHeldSeconds = (now - m_fHoldBeginMs) / 1000; m_iNaturalHeldSamples = m_iHoldSamples;
+			m_bNaturalResumeAccepted = CF_ConvoySession.CF_PanelResume(m_PacedOwner);
+			Print("[ConvoyFollower] NATURAL_RECOVERY_RESUME: accepted=" + m_bNaturalResumeAccepted + " held_s=" + m_fNaturalHeldSeconds +
+				" samples=" + m_iNaturalHeldSamples + " old_lease_failed=" + m_NaturalLease.Failed + " public_server_command=true");
+			if (!m_bNaturalResumeAccepted) { PairFailure("natural_recovery_resume_rejected"); return; }
+			m_bPairHoldMeasure = false; m_iNaturalStage = 5;
+			if (!ContinueOriginalGoal()) { PairFailure("natural_recovery_original_goal_restart_unavailable"); return; }
+			m_vNaturalResumeTail = m_PacedTrucks[2].Truck.GetOrigin();
+			// Parent samples were paused during recovery. Reanchor only interval
+			// endpoints: no unobserved movement may inherit today's throttle.
+			foreach (CF_PacedRoadTruckSample sample : m_PacedTrucks)
+			{
+				sample.LastPosition = sample.Truck.GetOrigin();
+				sample.LastForward = sample.Truck.GetWorldTransformAxis(2);
+			}
+			ResetRecoveryHoldScratch(); SetPairPhase(1);
+		}
+	}
+
+	override protected void EndPaced()
+	{
+		if (m_bPacedTerminal) return;
+		super.EndPaced();
+		if (!m_bPacedTerminal || m_bNaturalResult) return;
+		m_bNaturalResult = true;
+		bool recovered = m_bPairComplete && m_iNaturalCount == 1 && m_iNaturalStage == 5;
+		recovered = recovered && m_bNaturalRetired && m_bNaturalHoldAccepted && m_bNaturalResumeAccepted;
+		CF_NaturalRecoveryReadback read = NaturalRead();
+		recovered = recovered && m_fNaturalHeldSeconds >= 30 && m_iNaturalHeldSamples >= 30 && NaturalHistory(read);
+		recovered = recovered && read.Generation > m_iNaturalGeneration && !read.OriginalBlocked && !read.ActiveFallback;
+		string result = "[ConvoyFollower] NATURAL_RECOVERY_RESULT: workflow_complete=" + m_bPairComplete;
+		result += " workflow_recovered=" + recovered + " overall_pass=" + (m_bPairComplete && !m_bPacedFailed);
+		result += " natural_failure_count=" + m_iNaturalCount + " native_failure_retained=" + (m_NaturalLease && m_NaturalLease.Failed);
+		result += " clean_first_attempt=" + (m_iNaturalCount == 0 && m_bPairComplete && !m_bPacedFailed);
+		result += " recovery_hold_s=" + m_fNaturalHeldSeconds + " recovery_hold_samples=" + m_iNaturalHeldSamples;
+		result += " cargo_tested=true original_delivery_goal=true final_resume_gates_unchanged=true ordinary_input=false";
+		Print(result);
