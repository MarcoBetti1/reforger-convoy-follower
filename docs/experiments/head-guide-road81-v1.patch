+	protected bool CF_HeadGuideStoppedLeadReady()
+	{
+		if (!m_bTrailHeadArrival || m_Predecessor || !m_Session || m_Session != m_TrailHeadSession) return false;
+		if (!m_Session.IsCurrentLeader(this) || m_Session.GetUnitNumber(this) != 1) return false;
