+		if (CF_ConvoySession.GetForPlayer(m_Leader) != m_Session || m_Session.GetOrderingPlayerId() != m_iTrailHeadOwnerId) return false;
+		if (!m_LeadVehicle || m_LeadVehicle != m_TrailPredecessor || CF_GetCachedPlayerVehicle() != m_LeadVehicle) return false;
+		PlayerManager players = GetGame().GetPlayerManager();
+		if (!players || m_iTrailHeadOwnerId <= 0 || players.GetPlayerControlledEntity(m_iTrailHeadOwnerId) != m_Leader) return false;
+		ChimeraCharacter owner = ChimeraCharacter.Cast(m_Leader);
+		if (!owner || IsDriverDestroyed(owner) || owner.GetWorld() != m_TrailWorld) return false;
+		CharacterControllerComponent ownerCharacter = owner.GetCharacterController();
+		CompartmentAccessComponent ownerAccess = owner.GetCompartmentAccessComponent();
+		if (!ownerCharacter || ownerCharacter.IsUnconscious() || !ownerAccess || ownerAccess.IsGettingIn() || ownerAccess.IsGettingOut()) return false;
+		BaseCompartmentSlot ownerSlot = ownerAccess.GetCompartment();
+		if (ownerAccess.GetVehicleIn(owner) != m_LeadVehicle || !ownerSlot || ownerSlot.GetOccupant() != owner) return false;
+		CarControllerComponent car = CarControllerComponent.Cast(m_LeadVehicle.FindComponent(CarControllerComponent));
+		if (!car || !car.GetSimulation() || !car.GetPilotCompartmentSlot() || !m_TrailHeadLeadPilot) return false;
+		if (car.GetPilotCompartmentSlot().GetOccupant() != m_TrailHeadLeadPilot) return false;
+		ChimeraCharacter pilot = ChimeraCharacter.Cast(m_TrailHeadLeadPilot);
+		if (!pilot || IsDriverDestroyed(pilot) || pilot.GetWorld() != m_TrailWorld) return false;
+		CharacterControllerComponent character = pilot.GetCharacterController();
+		CompartmentAccessComponent access = pilot.GetCompartmentAccessComponent();
+		if (!character || character.IsUnconscious() || !access || access.IsGettingIn() || access.IsGettingOut()) return false;
+		if (access.GetVehicleIn(pilot) != m_LeadVehicle || access.GetCompartment() != car.GetPilotCompartmentSlot()) return false;
+		float speed = Math.AbsFloat(car.GetSimulation().GetSpeedKmh());
