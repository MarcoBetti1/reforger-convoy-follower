+		if (lease.NativeTarget != m_TrailPredecessor || lease.Predecessor != m_TrailPredecessor) return false;
+		if (lease.Distance != CF_ConvoySettings.Get().m_fStoppedGap || lease.Waypoint != CF_GetEntityFollowWaypoint()) return false;
+		if (!lease.Activity || lease.Activity.Lease != lease) return false;
+		if (lease.Activity.GetActionState() == EAIActionState.COMPLETED || lease.Activity.GetActionState() == EAIActionState.FAILED) return false;
