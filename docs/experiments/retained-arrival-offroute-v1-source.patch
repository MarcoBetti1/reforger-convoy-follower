+		if (!CF_CheckOriginalFollowLease(lease, reason)) return false;
+		// Selection is required to admit the exception, not to observe a later
+		// same-lease native parking preemption. No native authority is granted here.
+		return m_bRetainedArrivalOffRoute || lease.Executing(m_Group, reason);
+	}
