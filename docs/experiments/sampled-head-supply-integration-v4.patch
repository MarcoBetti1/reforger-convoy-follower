+	protected bool ResumeArrivalTransitionMatches(CF_OriginalFollowActivity activity)
+	{
+		if (m_iPairPhase != 8 || !activity || !m_PacedSession) return false;
+		CF_TrailGuideDriverControllerComponent tail = CF_TrailGuideDriverControllerComponent.Cast(PairDriver(2));
+		if (!tail) return false;
+		CF_TestGuideArrivalHandoff observed = tail.CF_TestReadGuideArrivalHandoff(activity);
