 // Private observation only. No method below changes route history/cursor,
 // native requests, physics or controls. The inherited guide policy is intact.
+// Test-only scalar receipt of the actual production handoff. This wrapper
+// calls the inherited method once and never changes its result or lifecycle.
+class CF_TestGuideArrivalHandoff
+{
+	int Epoch;
+	int PriorSequence;
+	int PriorGeneration;
+	int Generation;
+	int StopEpisode;
+	string PriorActivityKey;
+	string PriorWaypointKey;
+	string PriorGuideKey;
+	string WaypointKey;
+	string PredecessorKey;
+}
+
+modded class CF_TrailGuideDriverControllerComponent
+{
+	protected ref CF_TestGuideArrivalHandoff m_TestGuideArrivalHandoff;
+
+	override protected bool CF_TryGuideArrivalHandoff(CF_EntityFollowWaypoint waypoint, CF_EntityFollowActivity activity)
+	{
+		CF_TestGuideArrivalHandoff observed;
+		CF_OriginalFollowLease prior = m_OriginalFollowLease;
+		if (waypoint && activity && prior && m_TrailGuide && m_TrailPredecessor && m_bTrailJoined)
+		{
+			if (prior.Activity == activity && prior.Waypoint == waypoint && prior.NativeTarget == m_TrailGuide)
+			{
+				observed = new CF_TestGuideArrivalHandoff();
+				observed.Epoch = m_iTrailEpoch; observed.PriorSequence = activity.CF_GetSequence();
+				observed.PriorGeneration = prior.Generation; observed.StopEpisode = m_iEntityStopEpisode + 1;
+				observed.PriorActivityKey = activity.ToString(); observed.PriorWaypointKey = waypoint.GetID().ToString();
+				observed.PriorGuideKey = m_TrailGuide.GetID().ToString();
+				observed.PredecessorKey = m_TrailPredecessor.GetID().ToString();
+			}
+		}
+		bool handled = super.CF_TryGuideArrivalHandoff(waypoint, activity);
+		if (!handled || !observed) return handled;
+		CF_OriginalFollowLease next = m_OriginalFollowLease;
+		if (!next || next.Revoked || next.Failed || m_TrailGuide || m_bTrailGuideActive) return handled;
+		if (!next.Waypoint || next.Generation != observed.PriorGeneration + 1 || m_iTrailEpoch != observed.Epoch) return handled;
+		if (!m_bEntityStopAttempted || m_iEntityStopEpisode != observed.StopEpisode || m_iEntityStopReplacements != 1) return handled;
+		if (next.Predecessor != m_TrailPredecessor || next.NativeTarget != m_TrailPredecessor) return handled;
+		if (m_EntityStopTarget != m_TrailPredecessor || next.Distance != CF_ConvoySettings.Get().m_fStoppedGap) return handled;
+		string reason;
+		if (!next.BindingUnchanged() || !CF_CheckOriginalFollowLease(next, reason)) return handled;
+		observed.Generation = next.Generation; observed.WaypointKey = next.Waypoint.GetID().ToString();
+		m_TestGuideArrivalHandoff = observed;
+		string line = "[ConvoyFollower] TEST_GUIDE_ARRIVAL_HANDOFF: unit=" + m_iUnitNumber;
+		line += " epoch=" + observed.Epoch + " prior_sequence=" + observed.PriorSequence;
+		line += " prior_generation=" + observed.PriorGeneration + " generation=" + observed.Generation;
+		line += " prior_waypoint=" + observed.PriorWaypointKey + " prior_guide=" + observed.PriorGuideKey;
+		line += " waypoint=" + observed.WaypointKey + " predecessor=" + observed.PredecessorKey;
+		line += " stop_episode=" + observed.StopEpisode + " passive_observation=true movement_credit=false";
+		Print(line);
+		return handled;
+	}
+
+	CF_TestGuideArrivalHandoff CF_TestReadGuideArrivalHandoff(CF_OriginalFollowActivity activity)
+	{
+		CF_TestGuideArrivalHandoff observed = m_TestGuideArrivalHandoff;
+		if (!observed || !activity || !activity.Lease || activity.Lease != m_OriginalFollowLease) return null;
+		if (m_TrailGuide || m_bTrailGuideActive || m_bTrailBlocked || !m_bTrailJoined) return null;
+		if (m_iTrailEpoch != observed.Epoch || m_iEntityStopEpisode != observed.StopEpisode || !m_bEntityStopAttempted) return null;
+		if (m_EntityStopTarget != m_TrailPredecessor || activity.Lease.Predecessor != m_TrailPredecessor) return null;
+		if (!m_TrailPredecessor || m_TrailPredecessor.GetID().ToString() != observed.PredecessorKey) return null;
+		if (activity.Lease.Generation != observed.Generation || activity.Lease.NativeTarget != m_TrailPredecessor) return null;
+		if (!activity.Lease.Waypoint || activity.Lease.Waypoint.GetID().ToString() != observed.WaypointKey) return null;
+		if (activity.Lease.Distance != CF_ConvoySettings.Get().m_fStoppedGap) return null;
+		string reason;
+		if (!activity.Lease.Executing(m_Group, reason)) return null;
+		return observed;
+	}
+}
