+		if (observed.PredecessorKey != EntityKey(m_PacedTrucks[1].Truck)) return false;
+		if (activity.CF_GetSequence() <= m_BaselineSequences[1]) return false;
+		if (m_bResumeTailArrivalAccepted)
+			return activity.CF_GetSequence() == m_ResumeSequences[1] && activity.ToString() == m_ResumeActivityKeys[1] && observed.WaypointKey == m_ResumeWaypointKeys[1];
+		if (m_ResumeQualified[1] || m_ResumeSequences[1] <= m_BaselineSequences[1]) return false;
+		if (activity.CF_GetSequence() <= m_ResumeSequences[1]) return false;
+		return observed.PriorSequence == m_ResumeSequences[1] && observed.PriorActivityKey == m_ResumeActivityKeys[1] && observed.PriorWaypointKey == m_ResumeWaypointKeys[1];
+	}
+
+	override protected bool MixedAllowsArrivalProgress(int unit, CF_OriginalFollowActivity activity)
+	{
+		return unit == 2 && ResumeArrivalTransitionMatches(activity);
+	}
