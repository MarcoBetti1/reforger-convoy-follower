-	protected bool CF_IsRoutineRadioEvent(int eventId)
-	{
-		return eventId == CF_RadioEvent.READY || eventId == CF_RadioEvent.FOLLOWING ||
-			eventId == CF_RadioEvent.HOLDING;
-	}
