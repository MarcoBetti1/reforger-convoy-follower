+		int count;
+		foreach (AIActionBase action : actions)
+		{
+			if (!CF_EntityFollowActivity.Cast(action)) continue;
+			if (action.GetActionState() == EAIActionState.COMPLETED || action.GetActionState() == EAIActionState.FAILED) continue;
+			count++;
+		}
+		return count;
