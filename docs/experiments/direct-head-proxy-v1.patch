+// Exact current-predecessor proxy: no physics, collision, AI or route data.
+class CF_DirectFollowProxyEntityClass : GenericEntityClass {}
+class CF_DirectFollowProxyEntity : GenericEntity
+{
+	protected CF_EntityFollowDriverControllerComponent m_Controller;
+	protected World m_World;
+	protected IEntity m_Predecessor;
+	protected int m_Generation;
+	protected bool m_Bound;
+	void CF_Bind(CF_EntityFollowDriverControllerComponent controller, World world, IEntity predecessor, int generation)
+	{
+		if (m_Bound) return;
+		m_Bound = true;
+		m_Controller = controller;
+		m_World = world;
+		m_Predecessor = predecessor;
+		m_Generation = generation;
+	}
+	bool CF_HasLease(CF_EntityFollowWaypoint waypoint)
+	{
+		return m_Bound && m_Controller && m_Controller.CF_HasDirectProxyLease(this, waypoint, m_Predecessor, m_World, m_Generation);
+	}
+	int CF_GetGeneration() { return m_Generation; }
+	IEntity CF_GetPredecessor() { return m_Predecessor; }
+	void CF_Revoke() { m_Controller = null; }
+}
