+	protected bool CF_EntitySpeed(IEntity vehicle, out float speedKmh)
+	{
+		if (!vehicle)
+			return false;
+		CarControllerComponent car = CarControllerComponent.Cast(vehicle.FindComponent(CarControllerComponent));
+		if (!car || !car.GetSimulation())
+			return false;
