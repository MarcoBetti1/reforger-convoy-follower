+		vector transform[4];
+		m_DirectProxy.GetTransform(transform);
+		float error = vector.Distance(transform[3], m_vDirectProxySourceOrigin);
+		error = Math.Max(error, vector.Distance(transform[0], m_vDirectProxySourceRight));
