+		super.ClearWaypoints();
+		if (!m_Waypoint)
+		{
+			m_OriginalFollowLease = null;
+			if (m_DirectProxy && !CF_IsControlBlocked()) CF_DetachDirectProxy(!CF_ConvoySession.CF_IsWorldCleanup());
